# Copy to launch.env and fill in. Addresses and names only: never put a private key in this file.

# The dev wallet: deploys StockSage and owns all three contracts. The name you gave it in: node tools/import-key.js <name>
DEPLOYER_ACCOUNT=stocksage-dev2
# Where the 10% purchase share and 20% deployment-fee share go. Leave empty to use the dev wallet.
TREASURY_ADDRESS=
# Optional private RPC (for example Alchemy) if the public one drops connections. Remove the # to use it.
#ROBINHOOD_RPC_URL=
