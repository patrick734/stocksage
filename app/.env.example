# Copy to .env.local for development. On Vercel, set these under Project > Settings > Environment Variables.

# Public site address (used in links and stored agent config URLs).
NEXT_PUBLIC_SITE_URL=https://stocksage.fun
# Optional: X profile link in the footer, and the $SAGE address before set-token.sh puts it on-chain.
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_SAGE_CA=

# The AI that runs the agents. Pick one:
#
# A) A free OpenAI-compatible provider (no card needed). Set LLM_BASE_URL, LLM_API_KEY and AGENT_MODEL:
#    Google Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   (key: aistudio.google.com)
#    Groq:           LLM_BASE_URL=https://api.groq.com/openai/v1                           (key: console.groq.com)
#    OpenRouter:     LLM_BASE_URL=https://openrouter.ai/api/v1                             (key: openrouter.ai; free models end in ":free")
#    AGENT_MODEL is a model name from that provider's model list. No web search in this mode.
LLM_BASE_URL=
LLM_API_KEY=
#
# B) Claude through the Anthropic API (paid, with web search): set ANTHROPIC_API_KEY and AGENT_MODEL, leave LLM_BASE_URL empty.
ANTHROPIC_API_KEY=
#
AGENT_MODEL=

# Session cookies are signed with this. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Upstash Redis (Vercel Marketplace > Upstash > Redis sets these for you).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional private RPC for server-side reads.
ROBINHOOD_RPC_URL=

# Optional tuning (defaults shown).
# AGENT_EFFORT=low
# AGENT_MAX_TOKENS=8000
# AGENT_WEB_SEARCHES=2
# MIN_PAID_PRICE_WEI=20000000000000
# FREE_PER_ADDRESS_PER_DAY=10
# FREE_GLOBAL_PER_DAY=500
# REPLIES_PER_MINUTE=6
