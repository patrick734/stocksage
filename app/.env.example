# Copy to .env.local for development. On Vercel, set these under Project > Settings > Environment Variables.

# Public site address (used in links and stored agent config URLs).
NEXT_PUBLIC_SITE_URL=https://stocksage.fun
# Optional: X profile link in the footer, and the $SAGE address before set-token.sh puts it on-chain.
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_SAGE_CA=

# Anthropic API key, and the Claude model every agent runs on.
ANTHROPIC_API_KEY=
AGENT_MODEL=

# Session cookies are signed with this. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Upstash Redis (Vercel Marketplace > Upstash > Redis sets these for you).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional private RPC for server-side reads.
ROBINHOOD_RPC_URL=

# Optional tuning (defaults shown).
# AGENT_EFFORT=low
# AGENT_MAX_TOKENS=8000
# AGENT_WEB_SEARCHES=2
# MIN_PAID_PRICE_WEI=20000000000000
# FREE_PER_ADDRESS_PER_DAY=10
# FREE_GLOBAL_PER_DAY=500
# REPLIES_PER_MINUTE=6
